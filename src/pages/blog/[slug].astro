---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, dateAttr } from '../../lib/dates';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <article class="prose">
    <p class="mute">
      <time datetime={dateAttr(post.data.date)}>
        {
          formatDate(post.data.date, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </time>
    </p>
    <h1 class="page-title">{post.data.title}</h1>
    {post.data.description ? (
      <p class="page-lede">{post.data.description}</p>
    ) : null}
    <Content />
  </article>
  <p style="margin-top: 3rem">
    <a href="/writing/">← Back to writing</a>
  </p>

  <dialog class="img-lightbox" data-img-lightbox aria-label="Expanded image">
    <form method="dialog">
      <button type="submit" class="img-lightbox__close">Close</button>
    </form>
    <img src="" alt="" />
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector('[data-img-lightbox]');
  if (dialog instanceof HTMLDialogElement) {
    const enlarged = dialog.querySelector('img');
    document.querySelectorAll('.prose img').forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;
      if (img.closest('a')) return;
      img.addEventListener('click', () => {
        if (!(enlarged instanceof HTMLImageElement)) return;
        enlarged.src = img.currentSrc || img.src;
        enlarged.alt = img.alt;
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
