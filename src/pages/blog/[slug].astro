---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostTOC from '../../components/PostTOC.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, dateAttr } from '../../lib/dates';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(
  (h) =>
    h.depth >= 2 &&
    h.depth <= 3 &&
    h.slug !== 'contents' &&
    h.slug !== 'refs-and-notes',
);
const showToc = tocHeadings.length >= 2;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.social_image ?? post.data.image}
  ogType="article"
>
  <article class:list={['post-layout', showToc && 'post-layout--with-toc']}>
    <header class="post-intro">
      <p class="mute">
        <time datetime={dateAttr(post.data.date)}>
          {
            formatDate(post.data.date, {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
      </p>
      <h1 class="page-title">{post.data.title}</h1>
      {post.data.description ? (
        <p class="page-lede">{post.data.description}</p>
      ) : null}
    </header>
    {showToc && <PostTOC headings={tocHeadings} />}
    <div class="prose">
      {
        post.data.image && (
          <figure class="post-feature">
            <img
              src={post.data.image}
              alt={post.data.image_caption ?? ''}
            />
            {post.data.image_caption ? (
              <figcaption class="post-feature__caption">
                {post.data.image_caption}
              </figcaption>
            ) : null}
          </figure>
        )
      }
      <Content />
    </div>
  </article>
  <p style="margin-top: 3rem">
    <a href="/blog/">← Back to blog</a>
  </p>

  <dialog id="expanded-image" class="img-lightbox" data-img-lightbox aria-label="Expanded image">
    <form method="dialog">
      <button type="submit" class="img-lightbox__close">Close</button>
    </form>
    <img alt="" />
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector('[data-img-lightbox]');
  if (dialog instanceof HTMLDialogElement) {
    const enlarged = dialog.querySelector('img');
    let lockedScrollY: number | null = null;
    let opener: HTMLElement | null = null;

    const openLightbox = (trigger: HTMLElement, src: string, alt: string) => {
      if (!(enlarged instanceof HTMLImageElement)) return;
      opener = trigger;
      lockedScrollY = window.scrollY;
      // Freeze the page in place before showModal(), which otherwise jumps to the dialog node.
      document.body.style.position = 'fixed';
      document.body.style.top = `-${lockedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      enlarged.src = src;
      enlarged.alt = alt;
      dialog.showModal();
    };

    const unlockScroll = () => {
      if (lockedScrollY === null) return;
      const y = lockedScrollY;
      lockedScrollY = null;
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      window.scrollTo({ top: y, behavior: 'instant' });
      opener?.focus({ preventScroll: true });
      opener = null;
    };

    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
      if (img.closest('a, button')) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'figure-zoom';
      button.setAttribute('aria-label', img.alt ? `Enlarge image: ${img.alt}` : 'Enlarge image');
      button.setAttribute('aria-haspopup', 'dialog');
      button.setAttribute('aria-controls', dialog.id);
      img.replaceWith(button);
      button.append(img);
      button.addEventListener('click', () => openLightbox(button, img.currentSrc || img.src, img.alt));
    });

    // Text links that open an image in the same lightbox:
    // <a href="/assets/....jpg" data-lightbox>click here</a>
    document.querySelectorAll('.prose a[data-lightbox]').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      link.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        openLightbox(link, link.href, link.getAttribute('data-alt') ?? '');
      });
    });

    dialog.addEventListener('close', unlockScroll);

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
